{
  "name": "@klinking/colander",
  "version": "0.0.0",
  "license": "MIT",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./plain-date": {
      "types": "./dist/formats/plain-date.d.mts",
      "import": "./dist/formats/plain-date.mjs",
      "require": "./dist/formats/plain-date.cjs"
    },
    "./plain-date-time": {
      "types": "./dist/formats/plain-date-time.d.mts",
      "import": "./dist/formats/plain-date-time.mjs",
      "require": "./dist/formats/plain-date-time.cjs"
    },
    "./plain-month-day": {
      "types": "./dist/formats/plain-month-day.d.mts",
      "import": "./dist/formats/plain-month-day.mjs",
      "require": "./dist/formats/plain-month-day.cjs"
    },
    "./plain-year-month": {
      "types": "./dist/formats/plain-year-month.d.mts",
      "import": "./dist/formats/plain-year-month.mjs",
      "require": "./dist/formats/plain-year-month.cjs"
    },
    "./zoned-date-time": {
      "types": "./dist/formats/zoned-date-time.d.mts",
      "import": "./dist/formats/zoned-date-time.mjs",
      "require": "./dist/formats/zoned-date-time.cjs"
    },
    "./object": {
      "types": "./dist/formats/object.d.mts",
      "import": "./dist/formats/object.mjs",
      "require": "./dist/formats/object.cjs"
    },
    "./date": {
      "types": "./dist/formats/date.d.mts",
      "import": "./dist/formats/date.mjs",
      "require": "./dist/formats/date.cjs"
    }
  },
  "scripts": {
    "prepublishOnly": "vp run build"
  },
  "devDependencies": {
    "@base-ui/react": "^1.2.0",
    "@js-temporal/polyfill": "^0.5.1",
    "@playwright/test": "^1.58.2",
    "@size-limit/esbuild": "^12.0.1",
    "@size-limit/esbuild-why": "^12.0.1",
    "@size-limit/file": "^12.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^28.1.0",
    "oxlint": "^1.58.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "size-limit": "^12.0.1",
    "tsx": "^4.21.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@base-ui/react": ">=1.0.0",
    "react": ">=18",
    "react-dom": ">=18"
  }
}
