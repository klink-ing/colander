{
  "name": "@klinking/colander",
  "version": "0.0.0",
  "homepage": "https://github.com/klink-ing/colander#readme",
  "bugs": "https://github.com/klink-ing/colander/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klink-ing/colander.git",
    "directory": "package"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "typesVersions": {
    "*": {
      "plain-date": [
        "./dist/formats/plain-date.d.cts"
      ],
      "plain-date-time": [
        "./dist/formats/plain-date-time.d.cts"
      ],
      "plain-month-day": [
        "./dist/formats/plain-month-day.d.cts"
      ],
      "plain-year-month": [
        "./dist/formats/plain-year-month.d.cts"
      ],
      "zoned-date-time": [
        "./dist/formats/zoned-date-time.d.cts"
      ],
      "object": [
        "./dist/formats/object.d.cts"
      ],
      "date": [
        "./dist/formats/date.d.cts"
      ]
    }
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./plain-date": {
      "import": {
        "types": "./dist/formats/plain-date.d.mts",
        "default": "./dist/formats/plain-date.mjs"
      },
      "require": {
        "types": "./dist/formats/plain-date.d.cts",
        "default": "./dist/formats/plain-date.cjs"
      }
    },
    "./plain-date-time": {
      "import": {
        "types": "./dist/formats/plain-date-time.d.mts",
        "default": "./dist/formats/plain-date-time.mjs"
      },
      "require": {
        "types": "./dist/formats/plain-date-time.d.cts",
        "default": "./dist/formats/plain-date-time.cjs"
      }
    },
    "./plain-month-day": {
      "import": {
        "types": "./dist/formats/plain-month-day.d.mts",
        "default": "./dist/formats/plain-month-day.mjs"
      },
      "require": {
        "types": "./dist/formats/plain-month-day.d.cts",
        "default": "./dist/formats/plain-month-day.cjs"
      }
    },
    "./plain-year-month": {
      "import": {
        "types": "./dist/formats/plain-year-month.d.mts",
        "default": "./dist/formats/plain-year-month.mjs"
      },
      "require": {
        "types": "./dist/formats/plain-year-month.d.cts",
        "default": "./dist/formats/plain-year-month.cjs"
      }
    },
    "./zoned-date-time": {
      "import": {
        "types": "./dist/formats/zoned-date-time.d.mts",
        "default": "./dist/formats/zoned-date-time.mjs"
      },
      "require": {
        "types": "./dist/formats/zoned-date-time.d.cts",
        "default": "./dist/formats/zoned-date-time.cjs"
      }
    },
    "./object": {
      "import": {
        "types": "./dist/formats/object.d.mts",
        "default": "./dist/formats/object.mjs"
      },
      "require": {
        "types": "./dist/formats/object.d.cts",
        "default": "./dist/formats/object.cjs"
      }
    },
    "./date": {
      "import": {
        "types": "./dist/formats/date.d.mts",
        "default": "./dist/formats/date.mjs"
      },
      "require": {
        "types": "./dist/formats/date.d.cts",
        "default": "./dist/formats/date.cjs"
      }
    }
  },
  "scripts": {
    "prepublishOnly": "vp run build"
  },
  "devDependencies": {
    "@base-ui/react": "catalog:",
    "@js-temporal/polyfill": "catalog:",
    "@playwright/test": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:voidzero",
    "jsdom": "catalog:",
    "oxlint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "rollup-plugin-visualizer": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:voidzero",
    "vite-plus": "catalog:voidzero",
    "vitest": "catalog:voidzero"
  },
  "peerDependencies": {
    "@base-ui/react": ">=1.0.0",
    "react": ">=18",
    "react-dom": ">=18"
  }
}
