{
  "name": "@klinking/colander",
  "version": "0.0.0",
  "license": "MIT",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./plain-date": {
      "types": "./dist/formats/plain-date.d.mts",
      "import": "./dist/formats/plain-date.mjs",
      "require": "./dist/formats/plain-date.cjs"
    },
    "./plain-date-time": {
      "types": "./dist/formats/plain-date-time.d.mts",
      "import": "./dist/formats/plain-date-time.mjs",
      "require": "./dist/formats/plain-date-time.cjs"
    },
    "./plain-month-day": {
      "types": "./dist/formats/plain-month-day.d.mts",
      "import": "./dist/formats/plain-month-day.mjs",
      "require": "./dist/formats/plain-month-day.cjs"
    },
    "./plain-year-month": {
      "types": "./dist/formats/plain-year-month.d.mts",
      "import": "./dist/formats/plain-year-month.mjs",
      "require": "./dist/formats/plain-year-month.cjs"
    },
    "./zoned-date-time": {
      "types": "./dist/formats/zoned-date-time.d.mts",
      "import": "./dist/formats/zoned-date-time.mjs",
      "require": "./dist/formats/zoned-date-time.cjs"
    },
    "./object": {
      "types": "./dist/formats/object.d.mts",
      "import": "./dist/formats/object.mjs",
      "require": "./dist/formats/object.cjs"
    },
    "./date": {
      "types": "./dist/formats/date.d.mts",
      "import": "./dist/formats/date.mjs",
      "require": "./dist/formats/date.cjs"
    }
  },
  "scripts": {
    "prepublishOnly": "vp run build"
  },
  "devDependencies": {
    "@base-ui/react": "catalog:",
    "@js-temporal/polyfill": "catalog:",
    "@playwright/test": "catalog:",
    "@size-limit/esbuild": "catalog:",
    "@size-limit/esbuild-why": "catalog:",
    "@size-limit/file": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:voidzero",
    "jsdom": "catalog:",
    "oxlint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "rollup-plugin-visualizer": "catalog:",
    "size-limit": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:voidzero",
    "vite-plus": "catalog:voidzero",
    "vitest": "catalog:voidzero"
  },
  "peerDependencies": {
    "@base-ui/react": ">=1.0.0",
    "react": ">=18",
    "react-dom": ">=18"
  }
}
