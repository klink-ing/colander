{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript"],
  "options": {
    "typeAware": true,
    "typeCheck": true
  },
  "categories": {
    "correctness": "error"
  },
  "env": {
    "builtin": true
  },
  "overrides": [
    {
      "files": ["site/**/*.{ts,tsx}"],
      "rules": {
        "tailwind-canonical-classes/tailwind-canonical-classes": [
          "warn",
          {
            "cssPath": "./site/src/styles.css"
          }
        ]
      },
      "jsPlugins": ["eslint-plugin-tailwind-canonical-classes"]
    }
  ]
}
