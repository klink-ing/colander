{
  "name": "base-ui-cal",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build -c vite.lib.config.ts && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "perf": "vitest run 'grid.perf.test'",
    "perf:bench": "vitest bench 'utils.bench'",
    "lint": "biome check .",
    "check": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "size": "size-limit",
    "visualize": "VISUALIZE=1 vite build -c vite.lib.config.ts && open stats.html"
  },
  "peerDependencies": {
    "@base-ui/react": ">=1.0.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {},
  "devDependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^1.7.9",
    "@base-ui/react": "^1.2.0",
    "@biomejs/biome": "^2.4.4",
    "@js-temporal/polyfill": "^0.5.1",
    "@size-limit/esbuild": "^12.0.1",
    "@size-limit/esbuild-why": "^12.0.1",
    "@size-limit/file": "^12.0.1",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "20.19.27",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jsdom": "^28.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "size-limit": "^12.0.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^4.1.18",
    "typescript": "5.6.3",
    "vite": "^7.3.0",
    "vitest": "^4.0.18"
  }
}
