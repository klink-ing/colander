{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "sortPackageJson": true,
  "sortImports": {
    "partitionByNewline": true,
    "newlinesBetween": false
  },
  "overrides": [
    {
      "files": ["website/**/*.{ts,tsx}"],
      "options": {
        "sortTailwindcss": {
          "stylesheet": "./website/src/styles.css",
          "functions": ["cn"]
        }
      }
    }
  ]
}
